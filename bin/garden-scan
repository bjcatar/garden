#!/usr/bin/env python3
"""Observe coding activity in watched folders and write heatmap.json.

Run from systemd, the CLI, or the panel Refresh / open path.
"""
from __future__ import annotations

import fcntl
import json
import os
import subprocess
import sys
import time
from datetime import date, datetime, timedelta
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple

sys.path.insert(0, str(Path(__file__).resolve().parent))
import garden_lib as g

STATE_DIR = Path.home() / ".local/state/omarchy/garden"
SETTINGS_PATH = STATE_DIR / "settings.json"
HEATMAP_PATH = STATE_DIR / "heatmap.json"
STATE_PATH = STATE_DIR / "state.json"
LEDGER_PATH = STATE_DIR / "ledger.jsonl"
LOCK_PATH = STATE_DIR / "scan.lock"
USAGE_DIR = Path.home() / ".local/state/omarchy/agents/usage"
SKIP_DIR_NAMES = {
    ".git", ".hg", ".svn", ".venv", "venv", "node_modules", "target", "dist",
    "build", ".cache", ".tox", "__pycache__", ".mypy_cache", ".pytest_cache",
    "vendor", ".next", ".turbo", "coverage",
}
MAX_DEPTH = 6
GIT_TIMEOUT = 12


def _read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def load_settings() -> Dict[str, Any]:
    raw = _read_json(SETTINGS_PATH, None)
    settings = g.normalize_settings(raw if isinstance(raw, dict) else None)
    if not settings["authorEmails"]:
        email = _git_config(None, "user.email")
        if email:
            settings["authorEmails"] = [email]
    return settings


def save_settings(settings: Dict[str, Any]) -> None:
    atomic_replace(SETTINGS_PATH, json.dumps(settings, indent=2) + "\n")


def load_state() -> Dict[str, Any]:
    data = _read_json(STATE_PATH, {})
    return data if isinstance(data, dict) else {}


def atomic_replace(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def save_state(state: Dict[str, Any]) -> None:
    atomic_replace(STATE_PATH, json.dumps(state, indent=2) + "\n")


def _run_cmd(cmd: List[str], timeout: int) -> Tuple[Optional[int], str, Optional[str]]:
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
    except subprocess.TimeoutExpired:
        return None, "", "timeout"
    except FileNotFoundError:
        return None, "", "missing"
    except OSError:
        return None, "", "os"
    return result.returncode, result.stdout or "", None


def _git_run(repo: Optional[Path], args: List[str], timeout: int = GIT_TIMEOUT) -> Tuple[Optional[int], str, Optional[str]]:
    cmd = ["git"] if repo is None else ["git", "-C", str(repo)]
    return _run_cmd(cmd + args, timeout)


def _git(repo: Optional[Path], args: List[str], timeout: int = GIT_TIMEOUT) -> str:
    code, stdout, failure = _git_run(repo, args, timeout)
    if g.process_failed(code, failure):
        return ""
    return stdout


def _git_config(repo: Optional[Path], key: str) -> str:
    extra = ["config", "--global", "--get", key] if repo is None else ["config", "--get", key]
    return _git(repo, extra, timeout=4).strip()


def repo_label(repo: Path) -> str:
    return g.display_path(repo, Path.home())


def discover_repos(roots: List[str]) -> List[Path]:
    found: List[Path] = []
    seen: Set[str] = set()
    for raw in roots:
        if not g.validate_root(raw):
            continue
        root = g.expand_root(raw, Path.home()).resolve()
        for dirpath, dirnames, _files in os.walk(root, followlinks=False):
            rel = Path(dirpath)
            try:
                depth = len(rel.relative_to(root).parts)
            except ValueError:
                dirnames[:] = []
                continue
            if depth > MAX_DEPTH:
                dirnames[:] = []
                continue
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIR_NAMES]
            if (Path(dirpath) / ".git").exists():
                repo = Path(dirpath)
                key = str(repo)
                if key not in seen:
                    seen.add(key)
                    found.append(repo)
                dirnames[:] = []
    found.sort(key=lambda p: str(p).lower())
    return found


def muted(repo: Path, exclude: List[str]) -> bool:
    return g.repo_muted(repo_label(repo), str(repo), repo.name, exclude)


def _git_log_args(since: str) -> List[str]:
    return [
        "log",
        "--branches",
        "--since", since,
        "--pretty=format:%H%x09%ae%x09%ad%x09%s",
        "--date=format-local:%Y-%m-%d %H:%M:%S",
    ]


def _parse_git_log(text: str, repo: Path, emails: List[str], pattern: str) -> List[Dict[str, Any]]:
    events: List[Dict[str, Any]] = []
    seen: Set[str] = set()
    for line in text.splitlines():
        parts = line.split("\t", 3)
        if len(parts) < 4:
            continue
        full_hash, email, stamp, subject = parts
        if full_hash in seen:
            continue
        seen.add(full_hash)
        if not g.author_ok(email, emails):
            continue
        if g.ignore_subject(subject, pattern):
            continue
        try:
            local = datetime.strptime(stamp.strip(), "%Y-%m-%d %H:%M:%S")
        except ValueError:
            continue
        day = local.strftime("%Y-%m-%d")
        slot = g.event_slot(day, local.hour, local.minute)
        events.append({
            "type": "git",
            "day": day,
            "slot": slot[1],
            "hash": full_hash[:12],
            "subject": subject,
            "repo": repo_label(repo),
        })
    return events


def git_commit_events(repo: Path, settings: Dict[str, Any], since: str) -> List[Dict[str, Any]]:
    emails = settings.get("authorEmails") or []
    if not emails or not settings.get("sources", {}).get("git", True):
        return []
    pattern = settings.get("ignoreSubject") or g.DEFAULT_IGNORE_SUBJECT
    code, stdout, failure = _git_run(repo, _git_log_args(since))
    if g.process_failed(code, failure):
        return []
    return _parse_git_log(stdout, repo, emails, pattern)


def _parse_file_listing(listing: str, repo: Path, since_ts: float) -> List[Dict[str, Any]]:
    events: List[Dict[str, Any]] = []
    for rel in listing.split("\0"):
        if not rel:
            continue
        path = repo / rel
        if not g.is_code_file(path):
            continue
        try:
            st = path.lstat()
        except OSError:
            continue
        if st.st_size > g.MAX_FILE_BYTES:
            continue
        if st.st_mtime < since_ts:
            continue
        day, index = g.timestamp_slot(st.st_mtime)
        events.append({
            "type": "file",
            "day": day,
            "slot": index,
            "repo": repo_label(repo),
            "path": rel,
        })
    return events


def file_events(repo: Path, since_ts: float) -> List[Dict[str, Any]]:
    code, stdout, failure = _git_run(repo, ["ls-files", "-oc", "--exclude-standard", "-z"], timeout=20)
    if g.process_failed(code, failure):
        return []
    return _parse_file_listing(stdout, repo, since_ts)


def file_events_dir(root: Path, since_ts: float) -> List[Dict[str, Any]]:
    events: List[Dict[str, Any]] = []
    try:
        root = root.resolve()
    except OSError:
        return events
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        current = Path(dirpath)
        try:
            depth = len(current.relative_to(root).parts)
        except ValueError:
            dirnames[:] = []
            continue
        if depth > MAX_DEPTH:
            dirnames[:] = []
            continue
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIR_NAMES]
        if (current / ".git").exists() and current != root:
            dirnames[:] = []
            continue
        for name in filenames:
            path = current / name
            if not g.is_code_file(path):
                continue
            try:
                st = path.lstat()
            except OSError:
                continue
            if st.st_size > g.MAX_FILE_BYTES:
                continue
            if st.st_mtime < since_ts:
                continue
            try:
                rel = str(path.relative_to(root))
            except ValueError:
                continue
            day, index = g.timestamp_slot(st.st_mtime)
            events.append({
                "type": "file",
                "day": day,
                "slot": index,
                "repo": repo_label(root),
                "path": rel,
            })
    return events


def agent_events(state: Dict[str, Any]) -> Tuple[List[Dict[str, Any]], Dict[str, int]]:
    prev = state.get("agentCounts") or {}
    if not isinstance(prev, dict):
        prev = {}
    now_counts: Dict[str, int] = {}
    events: List[Dict[str, Any]] = []
    today = date.today().isoformat()
    if not USAGE_DIR.is_dir():
        return events, now_counts
    for path in sorted(USAGE_DIR.glob("*.json")):
        data = _read_json(path, {})
        if not isinstance(data, dict):
            continue
        agent_id = str(data.get("id") or path.stem)
        today_count = int(data.get("todayPrompts") or data.get("todaySessions") or 0)
        for row in data.get("recentDays") or []:
            if not isinstance(row, dict):
                continue
            if row.get("date") == today:
                today_count = int(row.get("messageCount") or today_count or 0)
        now_counts[agent_id] = today_count
        before = int(prev.get(agent_id) or 0)
        if today_count > before:
            ts = time.time()
            day, index = g.timestamp_slot(ts)
            events.append({
                "type": "agent",
                "day": day,
                "slot": index,
                "agent": agent_id,
            })
    return events, now_counts


def append_ledger(events: List[Dict[str, Any]]) -> None:
    if not events:
        return
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LEDGER_PATH.open("a", encoding="utf-8") as fh:
        for event in events:
            fh.write(json.dumps(event, separators=(",", ":")) + "\n")


def load_ledger() -> List[Dict[str, Any]]:
    if not LEDGER_PATH.is_file():
        return []
    try:
        lines = LEDGER_PATH.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    events: List[Dict[str, Any]] = []
    for line in lines:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict):
            events.append(event)
    return events


def load_ledger_events(start: date) -> List[Dict[str, Any]]:
    if not LEDGER_PATH.is_file():
        return []
    start_iso = start.isoformat()
    try:
        lines = LEDGER_PATH.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    events: List[Dict[str, Any]] = []
    for line in lines:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        day = event.get("day")
        if not isinstance(day, str) or day < start_iso:
            continue
        events.append(event)
    return events


def timer_enabled() -> bool:
    try:
        result = subprocess.run(
            ["systemctl", "--user", "is-enabled", "garden-scan.timer"],
            capture_output=True, text=True, timeout=8, check=False,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return False
    return result.returncode == 0 and "enabled" in (result.stdout or "")


def _active_repos(repos: List[Path], exclude: List[str]) -> List[Path]:
    return [repo for repo in repos if not muted(repo, exclude)]


def _file_probe(settings: Dict[str, Any], repos: List[Path], since_ts: float) -> g.Probe:
    if not settings.get("sources", {}).get("files", True):
        return g.ProbeOff()
    exclude = settings.get("excludeRepos") or []
    parts: List[g.ProbeOk | g.ProbeFailed] = []
    for repo in _active_repos(repos, exclude):
        code, stdout, failure = _git_run(repo, ["ls-files", "-oc", "--exclude-standard", "-z"], timeout=20)
        if g.process_failed(code, failure):
            parts.append(g.ProbeFailed(events=()))
        else:
            parts.append(g.ProbeOk(events=tuple(_parse_file_listing(stdout, repo, since_ts))))
    repo_keys = {str(repo.resolve()) for repo in repos}
    for raw in settings.get("roots") or []:
        if not g.validate_root(raw):
            continue
        try:
            root = g.expand_root(raw, Path.home()).resolve()
        except OSError:
            parts.append(g.ProbeFailed(events=()))
            continue
        if str(root) in repo_keys:
            continue
        parts.append(g.ProbeOk(events=tuple(file_events_dir(root, since_ts))))
    if not parts:
        return g.ProbeOff()
    return g.combine_file_probes(parts)


def _git_probe(settings: Dict[str, Any], repos: List[Path], today: date) -> g.Probe:
    emails = settings.get("authorEmails") or []
    if not emails or not settings.get("sources", {}).get("git", True):
        return g.ProbeOff()
    active = _active_repos(repos, settings.get("excludeRepos") or [])
    if not active:
        return g.ProbeOff()
    since = (today - timedelta(days=364)).isoformat()
    pattern = settings.get("ignoreSubject") or g.DEFAULT_IGNORE_SUBJECT
    ok = True
    events: List[Dict[str, Any]] = []
    for repo in active:
        code, stdout, failure = _git_run(repo, _git_log_args(since))
        if g.process_failed(code, failure):
            ok = False
            continue
        events.extend(_parse_git_log(stdout, repo, emails, pattern))
    if ok:
        return g.ProbeOk(events=tuple(events))
    return g.ProbeFailed(events=tuple(events))


def build_heatmap(
    settings: Dict[str, Any],
    state: Any,
    repos: List[Path],
    events: Optional[List[Dict[str, Any]]] = None,
) -> Dict[str, Any]:
    today = date.today()
    start = today - timedelta(days=364)
    if events is None:
        events = load_ledger()
    parsed = state if isinstance(state, g.ScanState) else g.parse_scan_state(state if isinstance(state, dict) else None)
    covered = g.cover_days(events, parsed, start, today)
    days_out = {iso: day.as_heatmap_day() for iso, day in covered.items()}
    today_iso = today.isoformat()
    today_row = days_out.get(today_iso) or {}
    total_slots = sum(int(row.get("slots") or 0) for row in days_out.values())
    active_days = sum(1 for row in days_out.values() if int(row.get("slots") or 0) > 0)
    review_rows = [
        {"day": day.day, "slots": set(day.observed_slot_indexes)}
        for day in covered.values()
        if day.observed_slot_indexes
    ]
    enabled = timer_enabled()
    coverage = {
        iso: row.get("coverage")
        for iso, row in days_out.items()
        if isinstance(row, dict) and isinstance(row.get("coverage"), str)
    }
    activity = g.summarize_activity(load_ledger_events(start), today, coverage)
    return {
        "generatedAt": datetime.now().isoformat(timespec="seconds"),
        "range": {"start": start.isoformat(), "end": today_iso},
        "today": {"date": today_iso, **today_row},
        "days": days_out,
        "totalSlots": total_slots,
        "activeDays": active_days,
        "roots": settings.get("roots") or [],
        "repos": [{"path": str(p), "name": p.name, "label": repo_label(p), "muted": muted(p, settings.get("excludeRepos") or [])} for p in repos],
        "sources": settings.get("sources"),
        "slotMinutes": settings.get("slotMinutes") or 30,
        "review": g.collect_review(review_rows, today),
        "yearNote": g.year_square_note(days_out),
        "activity": activity,
        "scanStatus": g.scan_status_text(parsed, enabled),
        "timerEnabled": enabled,
    }


def scan() -> Dict[str, Any]:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    settings = load_settings()
    if not SETTINGS_PATH.is_file():
        save_settings(settings)
    raw_state = load_state()
    state = g.parse_scan_state(raw_state)
    now = time.time()
    today = date.today()
    midnight = datetime.combine(today, datetime.min.time()).timestamp()
    file_since = g.file_since_ts(state.file_cursor, midnight)
    repos = discover_repos(settings.get("roots") or [])
    files = _file_probe(settings, repos, file_since)
    git = _git_probe(settings, repos, today)
    if settings.get("sources", {}).get("agents"):
        rows, counts = agent_events(raw_state)
        agents = g.ProbeOk(events=tuple(rows), agent_counts=counts)
    else:
        agents = g.ProbeOff()
    ledger = load_ledger()
    plan = g.plan_scan(state, ledger, files, git, agents, now, midnight)
    kept = g.retain_events(list(plan.events_to_append))
    append_ledger(kept)
    save_state(plan.state.to_json())
    snap = build_heatmap(settings, plan.state, repos, ledger + kept)
    atomic_replace(HEATMAP_PATH, json.dumps(snap) + "\n")
    return snap


def with_lock(fn):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("a+") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        return fn()


def _heatmap_repos() -> List[Dict[str, Any]]:
    data = _read_json(HEATMAP_PATH, None)
    if not isinstance(data, dict):
        return []
    repos = data.get("repos")
    if not isinstance(repos, list):
        return []
    return [repo for repo in repos if isinstance(repo, dict)]


def _read_manifest() -> Optional[Dict[str, Any]]:
    data = _read_json(PLUGIN_ROOT / "manifest.json", None)
    return data if isinstance(data, dict) else None


def _print_sheet(result: str, token: str, sheet: Dict[str, Any]) -> None:
    payload = {
        "result": result,
        "token": token,
        "version": sheet["version"],
        "roots": sheet["roots"],
        "offers": sheet["offers"],
        "mutes": sheet["mutes"],
        "openRepos": sheet["openRepos"],
        "subject": sheet["subject"],
        "hardSkipNote": sheet["hardSkipNote"],
    }
    sys.stdout.write(json.dumps(payload, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def _sheet(settings: Dict[str, Any], *, force_offers: bool) -> Dict[str, Any]:
    return g.settings_sheet(
        settings,
        _heatmap_repos(),
        _read_manifest(),
        home=Path.home(),
        force_offers=force_offers,
    )


def cmd_settings_sheet(force_offers: bool = False) -> int:
    settings = load_settings()
    _print_sheet("ok", "", _sheet(settings, force_offers=force_offers))
    return 0


def cmd_add_root(raw: str) -> int:
    def run() -> int:
        settings = load_settings()
        decision = g.root_decision(raw, home=Path.home())
        if decision.ok:
            updated = g.apply_add_root(settings, raw, home=Path.home())
            save_settings(updated)
            _print_sheet("ok", decision.token, _sheet(updated, force_offers=False))
            return 0
        force = decision.kind == "home"
        _print_sheet(
            "home" if force else "reject",
            decision.token,
            _sheet(settings, force_offers=force),
        )
        return 2 if force else 1

    return with_lock(run)


def cmd_remove_root(raw: str) -> int:
    def run() -> int:
        settings = load_settings()
        updated = g.apply_remove_root(settings, raw, home=Path.home())
        save_settings(updated)
        _print_sheet("ok", "", _sheet(updated, force_offers=False))
        return 0

    return with_lock(run)


def cmd_mute(raw: str, mute: bool) -> int:
    def run() -> int:
        settings = load_settings()
        updated = g.apply_mute(settings, raw, mute)
        save_settings(updated)
        _print_sheet("ok", "", _sheet(updated, force_offers=False))
        return 0

    return with_lock(run)


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
UNIT_FILES = ("garden-scan.service", "garden-scan.timer")


def _unit_src() -> Path:
    return PLUGIN_ROOT / "systemd"


def _default_user_unit_dir() -> Path:
    return Path.home() / ".config/systemd/user"


def _systemctl_user(*args: str) -> bool:
    try:
        result = subprocess.run(
            ["systemctl", "--user", *args],
            capture_output=True, text=True, timeout=20, check=False,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return False
    return result.returncode == 0


def install_timer(dest: Optional[Path] = None, run_systemctl: bool = True) -> int:
    src = _unit_src()
    dest_dir = Path(dest) if dest is not None else _default_user_unit_dir()
    dest_dir.mkdir(parents=True, exist_ok=True)
    for name in UNIT_FILES:
        body = src / name
        if not body.is_file():
            print("missing-unit", body)
            return 1
        (dest_dir / name).write_text(body.read_text(encoding="utf-8"), encoding="utf-8")
    if run_systemctl:
        if not _systemctl_user("daemon-reload"):
            print("systemctl-failed", "daemon-reload")
            return 1
        if not _systemctl_user("enable", "--now", "garden-scan.timer"):
            print("systemctl-failed", "enable")
            return 1
    print("ok", str(dest_dir))
    return 0


def uninstall_timer(dest: Optional[Path] = None, run_systemctl: bool = True) -> int:
    dest_dir = Path(dest) if dest is not None else _default_user_unit_dir()
    if run_systemctl:
        _systemctl_user("disable", "--now", "garden-scan.timer")
    for name in UNIT_FILES:
        path = dest_dir / name
        try:
            path.unlink()
        except FileNotFoundError:
            pass
    if run_systemctl:
        _systemctl_user("daemon-reload")
    print("ok")
    return 0


def _flag_value(argv: List[str], flag: str) -> Optional[str]:
    if flag not in argv:
        return None
    i = argv.index(flag)
    if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
        return argv[i + 1]
    return ""


WEEK_EXPORTS = ("--week-md", "--week-json", "--resume-md", "--write-week")
WEEK_NOTE_NAME = "this-week.md"
MISSING_HEATMAP = "No heatmap yet. Needs a scan."
MISSING_NOTE = "No week note in the heatmap. Needs a scan."
SCAN_NOTE = "Scan finished without a week note."
HELP = """\
usage: garden-scan [flags]

Scan watched folders into ~/.local/state/omarchy/garden/heatmap.json.

Week flags read that heatmap when generatedAt is at most 15 minutes old.
They scan first when the file is older or is not valid JSON. They do not
scan when the file or the week note is missing. Add --scan to scan first.
Project windows overlap. These flags do not add them into machine hours.

  --week-md       print activity.week.markdown
  --week-json     print a compact JSON summary of this week
  --resume-md     print a short handoff for an agent prompt
  --write-week    overwrite ~/.local/state/omarchy/garden/this-week.md
  --scan          scan before a week flag
  --stdout        scan, then print today's slot counts as JSON
  --help          show this help

  --add-root PATH
  --remove-root PATH
  --mute REPO
  --unmute REPO
  --settings-sheet [--offers]
  --install-timer [--prefix DIR]
  --uninstall-timer [--prefix DIR]
  --timer-status
"""


def _selected_exports(argv: List[str]) -> List[str]:
    return [flag for flag in WEEK_EXPORTS if flag in argv]


def _load_heatmap() -> Optional[Dict[str, Any]]:
    if not HEATMAP_PATH.is_file():
        return None
    data = _read_json(HEATMAP_PATH, None)
    return data if isinstance(data, dict) else None


def _week_report(snap: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    activity = snap.get("activity")
    if not isinstance(activity, dict):
        return None
    week = activity.get("week")
    if not isinstance(week, dict) or not g.week_markdown(week):
        return None
    return week


def _emit_week(mode: str, week: Dict[str, Any]) -> int:
    if mode == "--week-md":
        sys.stdout.write(g.week_markdown(week))
        return 0
    if mode == "--week-json":
        json.dump(g.week_summary(week), sys.stdout, ensure_ascii=False, separators=(",", ":"))
        sys.stdout.write("\n")
        return 0
    if mode == "--resume-md":
        sys.stdout.write(g.resume_markdown(week))
        return 0
    if mode == "--write-week":
        path = STATE_DIR / WEEK_NOTE_NAME
        atomic_replace(path, g.week_markdown(week))
        print(path)
        return 0
    print("Pass one of --week-md, --week-json, --resume-md, or --write-week.", file=sys.stderr)
    return 2


def cmd_export(mode: str, force_scan: bool) -> int:
    snap = None if force_scan else _load_heatmap()
    if snap is not None and g.heatmap_is_fresh(snap, datetime.now()):
        week = _week_report(snap)
        if week is None:
            print(MISSING_NOTE, file=sys.stderr)
            return 1
        return _emit_week(mode, week)
    if not force_scan and not HEATMAP_PATH.is_file():
        print(MISSING_HEATMAP, file=sys.stderr)
        return 1
    scanned = with_lock(scan)
    week = _week_report(scanned)
    if week is None:
        print(SCAN_NOTE, file=sys.stderr)
        return 1
    return _emit_week(mode, week)


def main(argv: List[str]) -> int:
    if "--help" in argv or "-h" in argv:
        sys.stdout.write(HELP)
        return 0

    prefix_raw = _flag_value(argv, "--prefix")
    prefix = Path(prefix_raw) if prefix_raw else None
    use_systemd = prefix is None

    exports = _selected_exports(argv)
    if len(exports) > 1 or (exports and "--stdout" in argv):
        print("Pass one of --week-md, --week-json, --resume-md, or --write-week.", file=sys.stderr)
        return 2
    if exports:
        return cmd_export(exports[0], "--scan" in argv)

    if "--install-timer" in argv:
        return install_timer(prefix, run_systemctl=use_systemd)
    if "--uninstall-timer" in argv:
        return uninstall_timer(prefix, run_systemctl=use_systemd)
    if "--timer-status" in argv:
        print("enabled" if timer_enabled() else "disabled")
        return 0
    if "--settings-sheet" in argv:
        return cmd_settings_sheet("--offers" in argv)
    if "--add-root" in argv:
        i = argv.index("--add-root")
        return cmd_add_root(argv[i + 1] if i + 1 < len(argv) else "")
    if "--remove-root" in argv:
        i = argv.index("--remove-root")
        return cmd_remove_root(argv[i + 1] if i + 1 < len(argv) else "")
    if "--mute" in argv:
        i = argv.index("--mute")
        return cmd_mute(argv[i + 1] if i + 1 < len(argv) else "", True)
    if "--unmute" in argv:
        i = argv.index("--unmute")
        return cmd_mute(argv[i + 1] if i + 1 < len(argv) else "", False)
    snap = with_lock(scan)
    if "--stdout" in argv:
        json.dump({"today": snap.get("today"), "activeDays": snap.get("activeDays"), "totalSlots": snap.get("totalSlots")}, sys.stdout)
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

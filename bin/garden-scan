#!/usr/bin/env python3
"""Observe coding activity in watched folders and write heatmap.json.

Run from systemd, the CLI, or the panel Refresh / open path.
"""
from __future__ import annotations

import fcntl
import json
import os
import subprocess
import sys
import time
from datetime import date, datetime, timedelta
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple

sys.path.insert(0, str(Path(__file__).resolve().parent))
import garden_lib as g

STATE_DIR = Path.home() / ".local/state/omarchy/garden"
SETTINGS_PATH = STATE_DIR / "settings.json"
HEATMAP_PATH = STATE_DIR / "heatmap.json"
STATE_PATH = STATE_DIR / "state.json"
LEDGER_PATH = STATE_DIR / "ledger.jsonl"
LOCK_PATH = STATE_DIR / "scan.lock"
USAGE_DIR = Path.home() / ".local/state/omarchy/agents/usage"
SKIP_DIR_NAMES = {
    ".git", ".hg", ".svn", ".venv", "venv", "node_modules", "target", "dist",
    "build", ".cache", ".tox", "__pycache__", ".mypy_cache", ".pytest_cache",
    "vendor", ".next", ".turbo", "coverage",
}
MAX_DEPTH = 6
GIT_TIMEOUT = 12


def _read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def load_settings() -> Dict[str, Any]:
    raw = _read_json(SETTINGS_PATH, None)
    settings = g.normalize_settings(raw if isinstance(raw, dict) else None)
    if not settings["authorEmails"]:
        email = _git_config(None, "user.email")
        if email:
            settings["authorEmails"] = [email]
    return settings


def save_settings(settings: Dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    SETTINGS_PATH.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")


def load_state() -> Dict[str, Any]:
    data = _read_json(STATE_PATH, {})
    return data if isinstance(data, dict) else {}


def save_state(state: Dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")


def _git(repo: Optional[Path], args: List[str], timeout: int = GIT_TIMEOUT) -> str:
    cmd = ["git"] if repo is None else ["git", "-C", str(repo)]
    try:
        result = subprocess.run(cmd + args, capture_output=True, text=True, timeout=timeout, check=False)
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return ""
    return result.stdout if result.returncode == 0 else ""


def _git_config(repo: Optional[Path], key: str) -> str:
    extra = ["config", "--global", "--get", key] if repo is None else ["config", "--get", key]
    return _git(repo, extra, timeout=4).strip()


def repo_label(repo: Path) -> str:
    home = str(Path.home())
    rel = str(repo)
    if rel.startswith(home + os.sep):
        return "~" + rel[len(home):]
    return rel


def discover_repos(roots: List[str]) -> List[Path]:
    found: List[Path] = []
    seen: Set[str] = set()
    for raw in roots:
        if not g.validate_root(raw):
            continue
        root = Path(raw).expanduser().resolve()
        for dirpath, dirnames, _files in os.walk(root, followlinks=False):
            rel = Path(dirpath)
            try:
                depth = len(rel.relative_to(root).parts)
            except ValueError:
                dirnames[:] = []
                continue
            if depth > MAX_DEPTH:
                dirnames[:] = []
                continue
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIR_NAMES]
            if (Path(dirpath) / ".git").exists():
                repo = Path(dirpath)
                key = str(repo)
                if key not in seen:
                    seen.add(key)
                    found.append(repo)
                dirnames[:] = []
    found.sort(key=lambda p: str(p).lower())
    return found


def muted(repo: Path, exclude: List[str]) -> bool:
    label = repo_label(repo)
    path = str(repo)
    for item in exclude:
        if item in (label, path, repo.name):
            return True
    return False


def git_commit_events(repo: Path, settings: Dict[str, Any], since: str) -> List[Dict[str, Any]]:
    emails = settings.get("authorEmails") or []
    if not emails or not settings.get("sources", {}).get("git", True):
        return []
    pattern = settings.get("ignoreSubject") or g.DEFAULT_IGNORE_SUBJECT
    events: List[Dict[str, Any]] = []
    seen: Set[str] = set()
    text = _git(repo, [
        "log",
        "--branches",
        "--since", since,
        "--pretty=format:%H%x09%ae%x09%ad%x09%s",
        "--date=format-local:%Y-%m-%d %H:%M:%S",
    ])
    for line in text.splitlines():
        parts = line.split("\t", 3)
        if len(parts) < 4:
            continue
        full_hash, email, stamp, subject = parts
        if full_hash in seen:
            continue
        seen.add(full_hash)
        if not g.author_ok(email, emails):
            continue
        if g.ignore_subject(subject, pattern):
            continue
        try:
            local = datetime.strptime(stamp.strip(), "%Y-%m-%d %H:%M:%S")
        except ValueError:
            continue
        day = local.strftime("%Y-%m-%d")
        slot = g.event_slot(day, local.hour, local.minute)
        events.append({
            "type": "git",
            "day": day,
            "slot": slot[1],
            "hash": full_hash[:12],
            "subject": subject,
            "repo": repo_label(repo),
        })
    return events


def file_events(repo: Path, since_ts: float) -> List[Dict[str, Any]]:
    listing = _git(repo, ["ls-files", "-oc", "--exclude-standard", "-z"], timeout=20)
    if not listing:
        return []
    events: List[Dict[str, Any]] = []
    for rel in listing.split("\0"):
        if not rel:
            continue
        path = repo / rel
        if not g.is_code_file(path):
            continue
        try:
            st = path.lstat()
        except OSError:
            continue
        if st.st_size > g.MAX_FILE_BYTES:
            continue
        if st.st_mtime < since_ts:
            continue
        day, index = g.timestamp_slot(st.st_mtime)
        events.append({
            "type": "file",
            "day": day,
            "slot": index,
            "repo": repo_label(repo),
            "path": rel,
        })
    return events


def file_events_dir(root: Path, since_ts: float) -> List[Dict[str, Any]]:
    events: List[Dict[str, Any]] = []
    try:
        root = root.resolve()
    except OSError:
        return events
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        current = Path(dirpath)
        try:
            depth = len(current.relative_to(root).parts)
        except ValueError:
            dirnames[:] = []
            continue
        if depth > MAX_DEPTH:
            dirnames[:] = []
            continue
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIR_NAMES]
        if (current / ".git").exists() and current != root:
            dirnames[:] = []
            continue
        for name in filenames:
            path = current / name
            if not g.is_code_file(path):
                continue
            try:
                st = path.lstat()
            except OSError:
                continue
            if st.st_size > g.MAX_FILE_BYTES:
                continue
            if st.st_mtime < since_ts:
                continue
            try:
                rel = str(path.relative_to(root))
            except ValueError:
                continue
            day, index = g.timestamp_slot(st.st_mtime)
            events.append({
                "type": "file",
                "day": day,
                "slot": index,
                "repo": repo_label(root),
                "path": rel,
            })
    return events


def agent_events(state: Dict[str, Any]) -> Tuple[List[Dict[str, Any]], Dict[str, int]]:
    prev = state.get("agentCounts") or {}
    if not isinstance(prev, dict):
        prev = {}
    now_counts: Dict[str, int] = {}
    events: List[Dict[str, Any]] = []
    today = date.today().isoformat()
    if not USAGE_DIR.is_dir():
        return events, now_counts
    for path in sorted(USAGE_DIR.glob("*.json")):
        data = _read_json(path, {})
        if not isinstance(data, dict):
            continue
        agent_id = str(data.get("id") or path.stem)
        today_count = int(data.get("todayPrompts") or data.get("todaySessions") or 0)
        for row in data.get("recentDays") or []:
            if not isinstance(row, dict):
                continue
            if row.get("date") == today:
                today_count = int(row.get("messageCount") or today_count or 0)
        now_counts[agent_id] = today_count
        before = int(prev.get(agent_id) or 0)
        if today_count > before:
            ts = time.time()
            day, index = g.timestamp_slot(ts)
            events.append({
                "type": "agent",
                "day": day,
                "slot": index,
                "agent": agent_id,
            })
    return events, now_counts


def append_ledger(events: List[Dict[str, Any]]) -> None:
    if not events:
        return
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LEDGER_PATH.open("a", encoding="utf-8") as fh:
        for event in events:
            fh.write(json.dumps(event, separators=(",", ":")) + "\n")


def load_ledger_slots(start: date) -> Dict[str, Dict[str, Any]]:
    days: Dict[str, Dict[str, Any]] = {}
    if not LEDGER_PATH.is_file():
        return days
    start_iso = start.isoformat()
    try:
        lines = LEDGER_PATH.read_text(encoding="utf-8").splitlines()
    except OSError:
        return days
    for line in lines:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        day = event.get("day")
        if not day or day < start_iso:
            continue
        bucket = days.setdefault(day, {
            "slots": set(), "commits": 0, "files": 0, "agents": 0, "repos": set(),
            "git_slots": set(), "obs_slots": set(), "file_paths": set(), "by_slot": {},
        })
        slot = event.get("slot")
        if isinstance(slot, int):
            bucket["slots"].add(slot)
            info = bucket["by_slot"].setdefault(slot, {"git": 0, "file": 0, "repos": set()})
            kind = event.get("type")
            if kind == "git":
                bucket["git_slots"].add(slot)
                bucket["commits"] += 1
                info["git"] += 1
            elif kind == "file":
                bucket["obs_slots"].add(slot)
                path = event.get("path") or ""
                if path:
                    bucket["file_paths"].add(f"{event.get('repo') or ''}:{path}")
                info["file"] += 1
            elif kind == "agent":
                bucket["obs_slots"].add(slot)
                bucket["agents"] += 1
            repo = event.get("repo")
            if repo:
                info["repos"].add(repo)
        repo = event.get("repo")
        if repo:
            bucket["repos"].add(repo)
    for bucket in days.values():
        bucket["files"] = len(bucket.get("file_paths") or [])
    return days


def timer_enabled() -> bool:
    try:
        result = subprocess.run(
            ["systemctl", "--user", "is-enabled", "garden-scan.timer"],
            capture_output=True, text=True, timeout=8, check=False,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return False
    return result.returncode == 0 and "enabled" in (result.stdout or "")


def build_heatmap(settings: Dict[str, Any], state: Dict[str, Any], repos: List[Path]) -> Dict[str, Any]:
    today = date.today()
    first = state.get("firstSampleAt")
    first_day = None
    if isinstance(first, (int, float)):
        first_day = datetime.fromtimestamp(first).date()
    start = today - timedelta(days=364)
    buckets = load_ledger_slots(start)

    days_out: Dict[str, Any] = {}
    cursor = start
    while cursor <= today:
        iso = cursor.isoformat()
        bucket = buckets.get(iso)
        if bucket:
            slots = bucket["slots"]
            obs = bucket["obs_slots"]
            git_only = bool(bucket["git_slots"]) and not obs
            coverage = "git-history-only" if git_only else "observed"
            by_slot = {}
            for idx, info in (bucket.get("by_slot") or {}).items():
                by_slot[str(idx)] = {
                    "git": info.get("git") or 0,
                    "file": info.get("file") or 0,
                    "repos": sorted(info.get("repos") or []),
                }
            days_out[iso] = {
                "slots": len(slots),
                "commits": bucket["commits"],
                "files": bucket["files"],
                "agents": bucket["agents"],
                "repos": sorted(bucket["repos"]),
                "coverage": coverage,
                "slotIndexes": sorted(slots),
                "bySlot": by_slot,
                "observedSlots": len(obs),
            }
        else:
            before_watch = first_day is not None and cursor < first_day
            days_out[iso] = {
                "slots": 0, "commits": 0, "files": 0, "agents": 0, "repos": [],
                "coverage": "unknown" if before_watch else "observed",
                "slotIndexes": [], "bySlot": {}, "observedSlots": 0,
            }
        cursor += timedelta(days=1)

    today_iso = today.isoformat()
    today_row = days_out.get(today_iso) or {"slots": 0, "commits": 0, "files": 0, "agents": 0, "repos": [], "coverage": "observed"}
    total_slots = sum(int(v.get("slots") or 0) for v in days_out.values())
    active_days = sum(1 for v in days_out.values() if int(v.get("slots") or 0) > 0)
    review_rows = []
    for iso, bucket in buckets.items():
        if bucket.get("git_slots") and not bucket.get("obs_slots"):
            continue
        review_rows.append({"day": iso, "slots": bucket.get("obs_slots") or bucket.get("slots") or set()})
    review = g.collect_review(review_rows, today)
    return {
        "generatedAt": datetime.now().isoformat(timespec="seconds"),
        "range": {"start": start.isoformat(), "end": today_iso},
        "today": {"date": today_iso, **today_row},
        "days": days_out,
        "totalSlots": total_slots,
        "activeDays": active_days,
        "roots": settings.get("roots") or [],
        "repos": [{"path": str(p), "name": p.name, "label": repo_label(p), "muted": muted(p, settings.get("excludeRepos") or [])} for p in repos],
        "sources": settings.get("sources"),
        "slotMinutes": settings.get("slotMinutes") or 30,
        "review": review,
        "timerEnabled": timer_enabled(),
    }


def scan() -> Dict[str, Any]:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    settings = load_settings()
    if not SETTINGS_PATH.is_file():
        save_settings(settings)
    state = load_state()
    now = time.time()
    last = float(state.get("lastSampleAt") or 0)
    first = state.get("firstSampleAt")
    if not first:
        state["firstSampleAt"] = now
        first = now
    midnight = datetime.combine(date.today(), datetime.min.time()).timestamp()
    file_since = g.file_since_ts(last, midnight)

    repos = discover_repos(settings.get("roots") or [])
    exclude = settings.get("excludeRepos") or []
    events: List[Dict[str, Any]] = []
    since = (date.today() - timedelta(days=364)).isoformat()
    repo_keys = {str(p.resolve()) for p in repos}

    for repo in repos:
        if muted(repo, exclude):
            continue
        if settings.get("sources", {}).get("git", True):
            events.extend(git_commit_events(repo, settings, since))
        if settings.get("sources", {}).get("files", True):
            events.extend(file_events(repo, file_since))

    if settings.get("sources", {}).get("files", True):
        for raw in settings.get("roots") or []:
            if not g.validate_root(raw):
                continue
            root = Path(raw).expanduser().resolve()
            if str(root) in repo_keys:
                continue
            events.extend(file_events_dir(root, file_since))

    agent_counts = state.get("agentCounts") or {}
    if settings.get("sources", {}).get("agents"):
        extra, agent_counts = agent_events(state)
        events.extend(extra)
    else:
        agent_counts = {}

    events = g.drop_bulk_checkout(events)

    # Git log is historical; only append git events we have not stored.
    seen_git = state.get("seenGit") or []
    seen_set = set(seen_git)
    new_events: List[Dict[str, Any]] = []
    for event in events:
        if event.get("type") == "git":
            key = event.get("hash")
            if key in seen_set:
                continue
            seen_set.add(key)
        new_events.append(event)

    append_ledger(new_events)
    state["lastSampleAt"] = now
    state["seenGit"] = list(seen_set)
    state["agentCounts"] = agent_counts
    save_state(state)
    snap = build_heatmap(settings, state, repos)
    HEATMAP_PATH.write_text(json.dumps(snap) + "\n", encoding="utf-8")
    return snap


def with_lock(fn):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("a+") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        return fn()


def cmd_add_root(raw: str) -> int:
    settings = load_settings()
    if not g.validate_root(raw):
        print("invalid-root", raw)
        return 1
    path = str(Path(raw).expanduser().resolve())
    roots = settings.get("roots") or []
    if path not in roots and raw not in roots:
        roots.append(path)
    settings["roots"] = roots
    save_settings(settings)
    print("ok")
    return 0


def cmd_remove_root(raw: str) -> int:
    settings = load_settings()
    target = str(Path(raw).expanduser())
    resolved = str(Path(raw).expanduser().resolve()) if Path(raw).expanduser().exists() else target
    settings["roots"] = [r for r in (settings.get("roots") or []) if r not in (raw, target, resolved)]
    save_settings(settings)
    print("ok")
    return 0


def cmd_mute(raw: str, mute: bool) -> int:
    settings = load_settings()
    exclude = list(settings.get("excludeRepos") or [])
    if mute and raw not in exclude:
        exclude.append(raw)
    if not mute:
        exclude = [x for x in exclude if x != raw]
    settings["excludeRepos"] = exclude
    save_settings(settings)
    print("ok")
    return 0


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
UNIT_FILES = ("garden-scan.service", "garden-scan.timer")


def _unit_src() -> Path:
    return PLUGIN_ROOT / "systemd"


def _default_user_unit_dir() -> Path:
    return Path.home() / ".config/systemd/user"


def _systemctl_user(*args: str) -> bool:
    try:
        result = subprocess.run(
            ["systemctl", "--user", *args],
            capture_output=True, text=True, timeout=20, check=False,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return False
    return result.returncode == 0


def install_timer(dest: Optional[Path] = None, run_systemctl: bool = True) -> int:
    src = _unit_src()
    dest_dir = Path(dest) if dest is not None else _default_user_unit_dir()
    dest_dir.mkdir(parents=True, exist_ok=True)
    for name in UNIT_FILES:
        body = src / name
        if not body.is_file():
            print("missing-unit", body)
            return 1
        (dest_dir / name).write_text(body.read_text(encoding="utf-8"), encoding="utf-8")
    if run_systemctl:
        if not _systemctl_user("daemon-reload"):
            print("systemctl-failed", "daemon-reload")
            return 1
        if not _systemctl_user("enable", "--now", "garden-scan.timer"):
            print("systemctl-failed", "enable")
            return 1
    print("ok", str(dest_dir))
    return 0


def uninstall_timer(dest: Optional[Path] = None, run_systemctl: bool = True) -> int:
    dest_dir = Path(dest) if dest is not None else _default_user_unit_dir()
    if run_systemctl:
        _systemctl_user("disable", "--now", "garden-scan.timer")
    for name in UNIT_FILES:
        path = dest_dir / name
        try:
            path.unlink()
        except FileNotFoundError:
            pass
    if run_systemctl:
        _systemctl_user("daemon-reload")
    print("ok")
    return 0


def _flag_value(argv: List[str], flag: str) -> Optional[str]:
    if flag not in argv:
        return None
    i = argv.index(flag)
    if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
        return argv[i + 1]
    return ""


def main(argv: List[str]) -> int:
    prefix_raw = _flag_value(argv, "--prefix")
    prefix = Path(prefix_raw) if prefix_raw else None
    use_systemd = prefix is None

    if "--install-timer" in argv:
        return install_timer(prefix, run_systemctl=use_systemd)
    if "--uninstall-timer" in argv:
        return uninstall_timer(prefix, run_systemctl=use_systemd)
    if "--timer-status" in argv:
        print("enabled" if timer_enabled() else "disabled")
        return 0
    if "--add-root" in argv:
        i = argv.index("--add-root")
        return cmd_add_root(argv[i + 1] if i + 1 < len(argv) else "")
    if "--remove-root" in argv:
        i = argv.index("--remove-root")
        return cmd_remove_root(argv[i + 1] if i + 1 < len(argv) else "")
    if "--mute" in argv:
        i = argv.index("--mute")
        return cmd_mute(argv[i + 1] if i + 1 < len(argv) else "", True)
    if "--unmute" in argv:
        i = argv.index("--unmute")
        return cmd_mute(argv[i + 1] if i + 1 < len(argv) else "", False)
    snap = with_lock(scan)
    if "--stdout" in argv:
        json.dump({"today": snap.get("today"), "activeDays": snap.get("activeDays"), "totalSlots": snap.get("totalSlots")}, sys.stdout)
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
